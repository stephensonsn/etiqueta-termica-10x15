{
  "manifest_version": 3,
  "name": "Etiqueta Térmica 10x15 - impressão direta",
  "version": "1.6.0",
  "description": "No TikTok Shop, ligado numa aba, emite a NF-e e cria as etiquetas dos pedidos novos a cada minuto e manda os arquivos direto para a ponte local, sem baixar; a ponte imprime na térmica.",
  "content_scripts": [
    {
      "matches": [
        "https://seller-br.tiktok.com/*"
      ],
      "js": [
        "captura.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://seller-br.tiktok.com/*"
      ],
      "js": [
        "tiktok.js",
        "automatico.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9100/*",
    "https://seller-br.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Etiqueta Térmica 10x15",
    "default_popup": "popup.html"
  }
}
