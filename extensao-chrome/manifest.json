{
  "manifest_version": 3,
  "name": "Etiqueta Térmica 10x15 - impressão direta",
  "version": "1.2.6",
  "description": "No TikTok Shop, ligado numa aba, baixa os arquivos de etiqueta, emite a NF-e e cria as etiquetas dos pedidos novos a cada 5 minutos; a ponte local imprime na térmica.",
  "content_scripts": [
    {
      "matches": [
        "https://seller-br.tiktok.com/*"
      ],
      "js": [
        "tiktok.js",
        "automatico.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:9100/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Etiqueta Térmica 10x15",
    "default_popup": "popup.html"
  }
}